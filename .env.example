# ── NVIDIA NIM API ──────────────────────────────────────────
# Primary API key
NVIDIA_API_KEY=nvapi-your_key_here

# Additional API keys for rotation (comma-separated, optional)
# Distributes embedding load across multiple keys
NVIDIA_API_KEYS_EXTRA=

# Embedding mode: "api" = NVIDIA cloud, "local" = run on your GPU (free, no rate limits)
# Local mode requires: pip install sentence-transformers
EMBED_MODE=api

# Embedding model (BGE-M3 on NVIDIA Build)
NVIDIA_EMBED_MODEL=baai/bge-m3

# Reranker model
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# LLM model for generation
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# ── App Settings ────────────────────────────────────────────
# Max documents to index (0 = ALL documents, no limit)
MAX_DOCUMENTS=0

# Backend port
API_PORT=8000

# ── Advanced RAG Features ───────────────────────────────────
# spaCy NER model (en_core_web_trf = transformer, en_core_web_sm = small)
SPACY_MODEL=en_core_web_trf

# Enable LLM-powered query rewriting (expansion, HyDE, decomposition)
ENABLE_QUERY_REWRITE=true

# Enable context compression before LLM generation
ENABLE_CONTEXT_COMPRESSION=true

# Enable multi-vector retrieval (summary + passage embeddings)
ENABLE_MULTI_VECTOR=true

# GraphRAG Leiden community resolution (higher = more communities)
GRAPHRAG_RESOLUTION=1.0
